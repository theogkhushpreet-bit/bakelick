# Supabase project -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use a long, random secret (at least 32 characters). Never expose this in frontend code.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Choose a strong admin password. This is the password for /admin.html.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: override the default delivery fee for Ambala orders (INR)
AMBALA_DELIVERY_FEE=45
